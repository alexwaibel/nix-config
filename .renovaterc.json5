{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':timezone(America/Los_Angeles)',
  ],
  nix: {
    // Beta manager; updates flake inputs and refreshes flake.lock via `nix flake update`
    enabled: true,
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'before 6am on Monday',
    ],
  },
  packageRules: [
    {
      description: 'Weekly flake input updates in one PR (merged by hand: they change what the machines run)',
      matchManagers: [
        'nix',
      ],
      groupName: 'flake inputs',
      schedule: [
        'before 6am on Monday',
      ],
    },
    {
      description: 'Auto-merge GitHub Actions after a supply-chain cool-off',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      automerge: true,
      automergeType: 'branch',
      minimumReleaseAge: '3 days',
      ignoreTests: true,
    },
  ],
}